# ==============================================================================
# SkillBridge Environment Configuration (Template)
# Copy this file to .env and adjust variables for your deployment environment.
# Never commit real credentials, secret keys, or private data to version control.
# ==============================================================================

# Backend Database Configuration
# Local development default: sqlite:///./skillbridge.db
# Managed PostgreSQL production example:
# DATABASE_URL=postgresql://skillbridge_user:your_secure_password@postgres.db.example.com:5432/skillbridge_prod
DATABASE_URL=sqlite:///./skillbridge.db

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Allowed CORS Origins (comma-separated for multiple origins)
# In production, replace with your frontend production domain (e.g., https://skillbridge.app)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Frontend API URL
# Leave blank for local dev reverse proxy (Vite proxy)
# For production frontend pointing to backend service: https://api.skillbridge.app
VITE_API_URL=
