# ==============================================================================
# SkillBridge Backend Environment Configuration (.env.example)
# ==============================================================================

# Database Connection (SQLite default, or Managed PostgreSQL)
# Local: sqlite:///./skillbridge.db
# PostgreSQL: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=sqlite:///./skillbridge.db

# Server Host and Port Binding
HOST=0.0.0.0
PORT=8000

# Environment: development | staging | production
ENVIRONMENT=production

# CORS Allowed Origins (comma-separated list)
# Example: https://skillbridge.example.com,https://app.skillbridge.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
