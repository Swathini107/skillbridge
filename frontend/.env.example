# ==============================================================================
# SkillBridge Frontend Environment Configuration (.env.example)
# ==============================================================================

# API Base URL for backend communication
# In local development: leave blank so Vite reverse proxy handles /api -> http://localhost:8000
# In production build: set to the public backend API domain
# Example: VITE_API_URL=https://api.skillbridge.example.com
VITE_API_URL=
